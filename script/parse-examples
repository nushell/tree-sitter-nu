#!/usr/bin/env bash

set -euo pipefail

clone() {
	if [[ -d examples/$1 ]]; then
		git -C "examples/$1" fetch origin "$3:$3" -f -u --depth=1
	else
		git clone "$2" "examples/$1" -b "$3" --single-branch --depth=1
	fi
}

clone nu_scripts https://github.com/nushell/nu_scripts main

find examples -name '*.nu' -and -type f -print >script/example-files.txt

# `tree-sitter parse` takes its grammar from the `parser-directories` in the
# user's config, which may hold another tree-sitter-nu checkout, and reuses a
# compiled library shared by all checkouts. Use only this checkout instead.
isolated=$(mktemp -d)
trap 'rm -rf "$isolated"' EXIT
mkdir "$isolated/parsers"
ln -s "$PWD" "$isolated/parsers/tree-sitter-nu"
printf '{"parser-directories": ["%s"]}\n' "$isolated/parsers" >"$isolated/config.json"
export TREE_SITTER_LIBDIR="$isolated/lib"

tree-sitter parse --config-path "$isolated/config.json" -q -s --paths script/example-files.txt |
	tee >(awk '/ERROR|MISSING/{print $1}' | sort >script/known-failures.txt)
